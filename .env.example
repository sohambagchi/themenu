# Supabase project URL (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase public anon key (safe for browser usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only key. Needed only for trusted server code (admin tasks, cron, webhooks).
# Not required for current client-side inventory flows that use anon key + RLS.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
