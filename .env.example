# Supabase project URL (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Server-only key used by protected Next.js server routes.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Static dashboard login credentials (used by /login).
DASHBOARD_USERNAME=chef
DASHBOARD_PASSWORD=change_me

# Random secret string used to sign dashboard session cookies.
DASHBOARD_SESSION_TOKEN=change_me_to_a_long_random_secret

# auth.users.id value for the single dashboard owner account.
# Server routes write/read inventory rows using this user_id.
DASHBOARD_OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# Optional: set true/1/yes to allow unauthenticated read access to inventory routes.
DASHBOARD_PUBLIC_READ=false
